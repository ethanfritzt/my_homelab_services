# Immich release tag (pin to avoid unexpected upgrades)
IMMICH_VERSION=v2.4.1

# Where uploaded media files are stored
UPLOAD_LOCATION=

# Where Postgres data files are stored (local disk only; no network shares)
DB_DATA_LOCATION=

# Postgres password (A-Za-z0-9 only; no special characters or spaces)
DB_PASSWORD=

# Postgres role name
DB_USERNAME=postgres

# Postgres database name
DB_DATABASE_NAME=immich

# Optional timezone (uncomment and set a TZ database name)
#TZ=
